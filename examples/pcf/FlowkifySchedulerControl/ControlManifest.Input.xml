<?xml version="1.0" encoding="utf-8"?>
<manifest>
  <control namespace="Flowkify" constructor="SchedulerControl" version="0.1.7" display-name-key="Flowkify Scheduler" description-key="Date-only employee scheduling and capacity board" control-type="virtual">
    <external-service-usage enabled="false" />
    <property name="configuration" display-name-key="Configuration" description-key="Optional JSON configuration fingerprint" of-type="Multiple" usage="input" required="false" />
    <property name="defaultView" display-name-key="Default view" description-key="The schedule view used when the control starts" of-type="Enum" usage="input" required="false">
      <value name="Day" display-name-key="Day">0</value>
      <value name="Week" display-name-key="Week">1</value>
      <value name="Month" display-name-key="Month">2</value>
    </property>
    <property name="height" display-name-key="Height" description-key="Scheduler height in pixels" of-type="Whole.None" usage="input" required="false" />
    <property name="selectedEntryId" display-name-key="Selected entry" description-key="The most recently opened allocation identifier" of-type="SingleLine.Text" usage="output" required="false" />
    <resources>
      <code path="index.ts" order="1" />
      <platform-library name="React" version="16.14.0" />
    </resources>
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>